DEBUG=false
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=asset_manager
POSTGRES_USER=asset_manager
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://asset_manager:replace-with-a-strong-password@db:5432/asset_manager
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
APP_PORT=8080
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=affairs-os
OIDC_CLIENT_SECRET=replace-with-your-oidc-client-secret
OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/oidc/callback/

# LDAP 目录同步（xrxs2ldap 写入，AffairsOS 读取；绑定密码只填在服务器 .env）
LDAP_URI=ldap://10.1.6.99:1389
LDAP_BASE_DN=dc=chencytech,dc=com
LDAP_BIND_DN=cn=readonly,dc=chencytech,dc=com
LDAP_BIND_PASSWORD=
LDAP_PEOPLE_OU=ou=people
LDAP_GROUPS_OU=ou=groups
LDAP_CONNECT_TIMEOUT_SECONDS=10
LDAP_SYNC_ENABLED=false
LDAP_SYNC_INTERVAL_MINUTES=60
LDAP_SYNC_CREATE_INACTIVE_USERS=false

EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="AffairsOS <noreply@example.com>"
EMAIL_SUBJECT_PREFIX="[行政资产管理] "
FRONTEND_URL=http://localhost:8080
LOCAL_LOGIN_USERNAME=admin
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# Optional image and package mirrors for restricted networks:
# PYTHON_BASE_IMAGE=python:3.13.3-slim
# PIP_INDEX_URL=https://pypi.org/simple
# NODE_BASE_IMAGE=node:22.16.0-alpine
# NGINX_BASE_IMAGE=nginx:1.27.4-alpine
# NPM_REGISTRY=https://registry.npmjs.org
# POSTGRES_IMAGE=postgres:17.5-alpine
# REDIS_IMAGE=redis:7.4.2-alpine
DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password

# Nextcloud 文件存储（应用密码只填写在 .env，不要提交）
NEXTCLOUD_ENABLED=false
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USERNAME=affairs-os
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_ROOT=/AffairsOS
NEXTCLOUD_TIMEOUT=30
